<Ui xmlns="http://www.blizzard.com/wow/ui/"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
	<Button name="SmartLoot_RollButtonTemplate" inherits="UIPanelButtonTemplate" virtual="true" motionScriptsWhileDisabled="true">
		<Size>
			<AbsDimension x="36" y="18" />
		</Size>
		<NormalText inherits="GameFontNormalSmall"/>
		<HighlightText inherits="GameFontHighlightSmall"/>
		<Scripts>
			<OnEnter>
				SmartLoot.OnRollButtonEnter(self);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Button>

	<Button name="SmartLoot_DropDownButtonTemplate" virtual="true" motionScriptsWhileDisabled="true">
		<Size>
			<AbsDimension x="22" y="22"/>
		</Size>
		<NormalTexture name="$parentNormalTexture" file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Up">
			<Size>
				<AbsDimension x="22" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="RIGHT"/>
			</Anchors>
		</NormalTexture>
		<PushedTexture name="$parentPushedTexture" file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Down">
			<Size>
				<AbsDimension x="22" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="RIGHT"/>
			</Anchors>
		</PushedTexture>
		<DisabledTexture name="$parentDisabledTexture" file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Disabled">
			<Size>
				<AbsDimension x="22" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="RIGHT"/>
			</Anchors>
		</DisabledTexture>
		<HighlightTexture name="$parentHighlightTexture" file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD">
			<Size>
				<AbsDimension x="22" y="22"/>
			</Size>
			<Anchors>
				<Anchor point="RIGHT"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<OnEnter>
				SmartLoot.OnRollButtonEnter(self);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Button>

	<Frame name="SmartLoot_RollTemplate" frameStrata="HIGH" virtual="true">
		<Size>
			<AbsDimension x="260" y="40"/>
		</Size>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background">
		</Backdrop>
		<Frames>
			<Button name="$parent_Icon">
				<Size>
					<AbsDimension x="35" y="35"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parent_Image">
							<Size>
								<AbsDimension x="35" y="35"/>
							</Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>
						SmartLoot.OnIconEnter(self);
					</OnEnter>
					<OnLeave>
						SmartLoot.OnIconLeave(self);
					</OnLeave>
					<OnUpdate>
						SmartLoot.OnIconUpdate(self);
					</OnUpdate>
				</Scripts>
			</Button>
			<Button name="$parent_Info">
				<Size>
					<AbsDimension x="215" y="15"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parent_Icon" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="5" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parent_ItemName" inherits="GameFontNormal" justifyH="LEFT">
							<Size>
								<AbsDimension x="215" y="15"/>
							</Size>
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT">
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>
			<Button name="$parent_Need" inherits="SmartLoot_RollButtonTemplate" text="Need">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_Icon" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="5" y="2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.DoRoll(self:GetParent(), SmartLoot.Roll.Need);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_NeedAdvanced" inherits="SmartLoot_DropDownButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_Need" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-3" y="-2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.ToggleRollDropDown(self, "Need");
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_Greed" inherits="SmartLoot_RollButtonTemplate" text="Greed">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_NeedAdvanced" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="0" y="2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.DoRoll(self:GetParent(), SmartLoot.Roll.Greed);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_GreedAdvanced" inherits="SmartLoot_DropDownButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_Greed" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-3" y="-2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.ToggleRollDropDown(self, "Greed");
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_Disenchant" inherits="SmartLoot_RollButtonTemplate" text="DE">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_GreedAdvanced" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="0" y="2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.DoRoll(self:GetParent(), SmartLoot.Roll.Disenchant);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_DisenchantAdvanced" inherits="SmartLoot_DropDownButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_Disenchant" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-3" y="-2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.ToggleRollDropDown(self, "Disenchant");
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_Pass" inherits="SmartLoot_RollButtonTemplate" text="Pass">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_DisenchantAdvanced" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="0" y="2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.DoRoll(self:GetParent(), SmartLoot.Roll.Pass);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parent_PassAdvanced" inherits="SmartLoot_DropDownButtonTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent_Pass" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-3" y="-2" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						SmartLoot.ToggleRollDropDown(self, "Pass");
					</OnClick>
				</Scripts>
			</Button>
			<StatusBar name="$parent_Timeout">
				<Size>
					<AbsDimension x="260" y="5" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" />
				</Anchors>
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
				<BarColor r="1.0" g="0.7" b="0.0"/>
				<Scripts>
					<OnUpdate>
						SmartLoot.OnTimeoutBarUpdate(self:GetParent());
					</OnUpdate>
				</Scripts>
			</StatusBar>
		</Frames>
	</Frame>

	<Frame name="SmartLoot_LootFrame" frameStrata="HIGH" enableMouse="true" movable="true" parent="UIParent">
		<Size>
			<AbsDimension x="200" y="30" />
		</Size>

		<Anchors>
			<Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER" />
		</Anchors>

		<TitleRegion setAllPoints="true" />

		<Layers>
			<Layer level="ARTWORK">
				<FontString inherits="GameFontHighlight" text="SmartLoot Anchor" justifyH="CENTER">
					<Size>
						<AbsDimension x="200" y="20" />
					</Size>

					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>

		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background">
			<BackgroundInsets>
				<AbsInset top="12"/>
			</BackgroundInsets>
		</Backdrop>

		<Scripts>
			<OnLoad>
				SmartLoot.OnLoad(self);
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
